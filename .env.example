# ============================================================
# .env.example  —  copy to .env and fill in (the real .env is gitignored)
#
#   cp .env.example .env
#
# The dashboard runs WITHOUT any of these values:
#   • no DB_URL  → loads the bundled CSV (data/churn/featured/churn.csv)
#   • no AI keys → AI insight panels run in demo/fallback mode
# Fill them in only to enable the live Oracle DB and/or live LLM insights.
# ============================================================

# ── LLM keys (optional) — leave blank to run AI in demo mode ──
# Slots 1–4: Groq (free tier).   https://console.groq.com/keys
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
# Slot 5: Claude (optional).     https://console.anthropic.com/
CLAUDE_API_KEY_5=
# Slot 6: Gemini (optional).     https://aistudio.google.com/apikey
GEMINI_API_KEY_6=
# Force a single slot (e.g. Groq_1). Leave blank for auto-failover.
USE_ONLY=

# ── Database (optional) — leave blank to run on the bundled CSV ──
# Oracle example: oracle+oracledb://user:pass@host:1521/?service_name=XEPDB1
DB_URL=

# ── Server (optional) ──
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=6001
